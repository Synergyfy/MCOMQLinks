generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  password           String
  name               String?
  role               String           @default("BUSINESS")
  postalCode         String?
  businessProfile    BusinessProfile?
  managingBusinesses BusinessProfile[] @relation("AgentBusinesses")
  mcomUserId         String?          @unique
  mcomAccessToken    String?
  mcomRefreshToken   String?
  mcomPermissions    String?
  autoRenew          Boolean          @default(true)
  membership         Membership?
  membershipPayments MembershipPayment[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Activity {
  id            String   @id @default(uuid())
  type          String // 'SCAN', 'CLAIM', 'REDEMPTION', 'VIEW', 'DIRECTIONS'
  description   String
  visitorId     String   @default("Anonymous")
  interestScore String   @default("medium")
  device        String   @default("Unknown")
  offerId       String?
  offer         Offer?   @relation(fields: [offerId], references: [id])
  createdAt     DateTime @default(now())
}

model Offer {
  id              String        @id @default(uuid())
  businessName    String        @default("Unknown Business")
  headline        String
  description     String
  imageUrl        String
  scans           Int           @default(0)
  claims          Int           @default(0)
  activeViewers   Int           @default(0)
  startDate       DateTime      @default(now())
  endDate         DateTime
  ctaLabel        String        @default("Claim Offer") // e.g. "Save to Phone", "WhatsApp", "Getting Here"
  ctaType         String        @default("claim") // claim, redeem, redirect
  leadDestination String        @default("") // e.g. URL, Phone number, Email
  redemptionCode  String?
  mediaType       String        @default("image") // image, video
  status          String        @default("draft") // draft, submitted, approved, rejected, expired
  rejectionReason String?
  visibility      String        @default("national") // national, hyperlocal
  targetPostcode  String?
  isPremium       Boolean       @default(false)
  seasonId        String?
  season          SeasonalRule? @relation(fields: [seasonId], references: [id])
  activities      Activity[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SupportMessage {
  id        String   @id @default(uuid())
  text      String
  sender    String // 'user' or 'agent'
  time      String // Using string for now to match frontend mock "Yesterday, 2:30 PM", or we could use DateTime
  userId    String? // Optional for now, link to User if needed later
  createdAt DateTime @default(now())
}

model BusinessProfile {
  id                 String  @id @default(uuid())
  name               String
  description        String
  logoUrl            String?
  contactEmail       String
  contactPhone       String?
  address            String?
  primaryColor       String  @default("#2563eb")
  secondaryColor     String  @default("#f8fafc")
  ownerName          String  @default("")
  plan               String  @default("None") // None, Hyper-local, Nearby, National
  subscriptionStatus String  @default("pending") // active, suspended, pending
  activePlanId       String?
  activePlan         Plan?   @relation(fields: [activePlanId], references: [id])
  planExpiresAt      DateTime?
  user               User    @relation(fields: [userId], references: [id])
  userId             String  @unique
  agent              User?   @relation("AgentBusinesses", fields: [agentId], references: [id])
  agentId            String?
}

model Location {
  id            String         @id @default(uuid())
  slug          String         @unique
  name          String
  campaignName  String
  address       String
  city          String?
  postcode      String?
  scope         String         @default("hyperlocal") // national, hyperlocal
  isActive      Boolean        @default(true)
  rotatorConfig RotatorConfig?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RotatorConfig {
  id               String   @id @default(uuid())
  locationId       String   @unique
  location         Location @relation(fields: [locationId], references: [id])
  type             String   @default("sequential") // sequential, random, scarcity, split
  fallbackBehavior String   @default("default") // default, link, expired
  customLink       String?
  offerSequence    String   @default("[]") // JSON array of offer IDs
  weights          String   @default("{}") // JSON object
  scarcityLimits   String   @default("{}") // JSON object
  pointer          Int      @default(0) // Current rotation pointer
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(uuid())
  type      String // error, warning, info
  message   String
  source    String   @default("system") // system, admin_user
  timestamp DateTime @default(now())
}

model GlobalConfig {
  id             String   @id @default("global-settings")
  emergencyPause Boolean  @default(false)
  priorityRule   String   @default("override") // override, intermittent
  brandColor     String   @default("#0a0a0a")
  headerText     String   @default("Supporting Local Business")
  footerText     String   @default("Powered by MCOMLinks System")
  showSocials    Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model SeasonalRule {
  id        String   @id @default(uuid())
  name      String // e.g., "Winter 2026", "Black Friday"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  offers    Offer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MCOM Unified Membership & Plan Architecture
// Plan Family (e.g. Starter, Hyper-local, Nearby Expansion, National Network, Gold)
model Plan {
  id                     String           @id @default(uuid())
  name                   String
  slug                   String           @unique
  description            String?
  monthlyPrice           Float            @default(0)
  quarterlyPrice         Float            @default(0)
  annualPrice            Float            @default(0)
  features               String           @default("[]") // JSON array of strings
  limitations            String           @default("[]") // JSON array of strings
  configuration          String           @default("{}") // JSON { quotas, featureFlags }
  tagline                String?
  bestFor                String?
  isFree                 Boolean          @default(false)
  isActive               Boolean          @default(true)
  isDefault              Boolean          @default(false)
  type                   String           @default("STANDARD") // STANDARD | TRIAL | SEASONAL
  trialDuration          Int?
  seasonId               String?
  stripeMonthlyPriceId   String?
  stripeQuarterlyPriceId String?
  stripeAnnualPriceId    String?
  paypalMonthlyPlanId    String?
  paypalQuarterlyPlanId  String?
  paypalAnnualPlanId     String?
  variants               PlanVariant[]
  activeBusinesses       BusinessProfile[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

// Plan Tier Levels: STANDARD (90d), PRO (180d), PRO_PLUS (1 Calendar Year)
model PlanTierLevel {
  id             String        @id @default(uuid())
  name           String        @unique // STANDARD | PRO | PRO_PLUS
  sortOrder      Int
  durationDays   Int?          // 90 | 180 | null
  isCalendarYear Boolean       @default(false)
  variants       PlanVariant[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// Plan Variant: The atomic sellable unit (1 Plan Family x 1 Plan Tier Level)
model PlanVariant {
  id            String        @id @default(uuid())
  planId        String
  plan          Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  tierLevelId   String
  tierLevel     PlanTierLevel @relation(fields: [tierLevelId], references: [id])
  isActive      Boolean       @default(true)
  features      String        @default("[]") // JSON array of strings
  limitations   String        @default("[]") // JSON array of strings
  configuration String        @default("{}") // JSON { quotas, featureFlags, disabledNavIds }
  prices        PlanPrice[]
  memberships   Membership[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Plan Price: Immutable, versioned pricing record
model PlanPrice {
  id            String        @id @default(uuid())
  planVariantId String
  planVariant   PlanVariant   @relation(fields: [planVariantId], references: [id], onDelete: Cascade)
  currency      String        @default("GBP")
  amount        Float
  stripePriceId String?
  paypalPlanId  String?
  isActive      Boolean       @default(true)
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?
  memberships   Membership[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Membership: 1:1 active subscription per user
model Membership {
  id            String             @id @default(uuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planVariantId String
  planVariant   PlanVariant        @relation(fields: [planVariantId], references: [id])
  priceId       String?
  price         PlanPrice?         @relation(fields: [priceId], references: [id])
  isActive      Boolean            @default(true)
  isTrial       Boolean            @default(false)
  startDate     DateTime           @default(now())
  expiresAt     DateTime
  endDate       DateTime
  paymentId     String?
  payment       MembershipPayment? @relation(fields: [paymentId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// MembershipPayment: Verified payment record
model MembershipPayment {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String       @default("GBP")
  paymentMethod String       // mcom_wallet | stripe | paypal
  transactionId String       @unique
  memberships   Membership[]
  createdAt     DateTime     @default(now())
}

model CmsSetting {
  id        String   @id @default("homepage-settings")
  content   String   @default("{}") // JSON string for hero, features, callouts
  updatedAt DateTime @updatedAt
}

model PromoBanner {
  id              String   @id @default("promo-settings")
  bannerText      String   @default("🎉 Special Offer: Get 20% off Premium Rotator spots this month!")
  ctaText         String   @default("Upgrade Now")
  ctaLink         String   @default("/pricing")
  backgroundColor String   @default("#2563eb")
  textColor       String   @default("#ffffff")
  isActive        Boolean  @default(true)
  startDate       DateTime @default(now())
  endDate         DateTime @default("2099-12-31T23:59:59.999Z")
  updatedAt       DateTime @updatedAt
}

model AdUnit {
  id              String   @id @default(uuid())
  businessName    String
  headline        String
  description     String?
  mediaType       String   @default("image") // image, video
  imageUrl        String
  targetUrl       String
  placement       String   @default("homepage") // homepage, sidebar, storefront
  status          String   @default("pending") // pending, approved, rejected
  rejectionReason String?
  budget          Float    @default(0.0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AgentCommLog {
  id         String   @id @default(uuid())
  businessId String
  agentId    String?
  agentName  String   @default("Field Agent")
  type       String   @default("note") // call, email, visit, note
  notes      String
  outcome    String?
  createdAt  DateTime @default(now())
}

